{
  "name": "boilerplate-wdio",
  "type": "module",
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "clean": "rimraf allure-results && rimraf allure-report && rimraf junit-results",
    "clean-report": "allure generate --clean ./allure-results",
    "open-report": "npm run clean-report && allure open",
    "report": "npm run clean-report && npm run open-report"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^10.0.0",
    "@wdio/appium-service": "^10.0.0",
    "@wdio/cli": "^10.0.0",
    "@wdio/globals": "^10.0.0",
    "@wdio/junit-reporter": "^10.0.0",
    "@wdio/local-runner": "^10.0.0",
    "@wdio/mocha-framework": "^10.0.0",
    "@wdio/spec-reporter": "^10.0.0",
    "allure-commandline": "^2.46.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "8.6.1",
    "rimraf": "^6.1.3"
  },
  "overrides": {
    "@appium/base-driver": "10.8.1",
    "axios": "1.20.0",
    "brace-expansion@^5.0.0": "5.0.12",
    "morgan": "1.12.1",
    "proxy-addr": "2.0.8",
    "sharp": "0.35.5",
    "shell-quote": "1.12.0"
  }
}
